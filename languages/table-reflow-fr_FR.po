#. Plugin URI of the plugin
#: table-reflow.php
msgid "https://github.com/Fyrins/table-reflow"
msgstr ""

#. Description of the plugin
#: table-reflow.php
msgid "Adds a \"stacked on mobile\" option to the WordPress table block. Below a chosen width each row becomes a card and every cell is prefixed with its column header, so tables stop scrolling sideways. Helps meet WCAG 2.2 success criterion 1.4.10 (Reflow)."
msgstr "Ajoute au bloc Tableau de WordPress une option d'affichage empilé sur mobile. Sous la largeur choisie, chaque ligne devient une carte et chaque cellule est précédée de son en-tête de colonne, ce qui supprime le défilement horizontal. Aide à satisfaire le critère 1.4.10 (Redimensionnement du contenu) des WCAG 2.2."

